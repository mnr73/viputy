{
  "name": "@mnr73/viputy",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 form inputs with first-class Persian/RTL and Jalali calendar support. Plain CSS variables, SSR-safe, zero runtime dependencies.",
  "keywords": [
    "vue",
    "input",
    "form",
    "jalali",
    "persian",
    "datepicker",
    "rtl"
  ],
  "author": "Milad Nazari",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnr73/viputy.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "skills"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/viputy.css"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitepress": "^2.0.0-alpha.21",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
